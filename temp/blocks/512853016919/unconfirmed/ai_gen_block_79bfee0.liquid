{% doc %}
  @prompt
    Create a video block with a play button overlay that includes a setting to enable or disable audio/sound when users click play. The block should allow merchants to upload a video file, add a thumbnail image, and toggle whether the video plays with sound or muted when clicked.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-block-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: #000000;
  }

  .ai-video-element-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-video-thumbnail-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-video-thumbnail-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-video-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-video-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, opacity 0.3s ease;
    z-index: 2;
  }

  .ai-video-play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-video-play-button-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-play-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    margin-left: calc({{ block.settings.play_button_size }}px * 0.05);
    fill: {{ block.settings.play_button_icon_color }};
  }

  .ai-video-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: flex;
    gap: 10px;
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-video-wrapper-{{ ai_gen_id }}:hover .ai-video-controls-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-video-control-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.control_button_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .ai-video-control-button-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-video-control-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.control_button_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-video-play-button-{{ ai_gen_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.8);
      height: calc({{ block.settings.play_button_size }}px * 0.8);
    }

    .ai-video-play-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.32);
      height: calc({{ block.settings.play_button_size }}px * 0.32);
      margin-left: calc({{ block.settings.play_button_size }}px * 0.04);
    }

    .ai-video-controls-{{ ai_gen_id }} {
      opacity: 1;
    }
  }
{% endstyle %}

<video-player-{{ ai_gen_id }}
  class="ai-video-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-autoplay="{{ block.settings.autoplay }}"
  data-loop="{{ block.settings.loop }}"
  data-enable-sound="{{ block.settings.enable_sound }}"
>
  <div class="ai-video-wrapper-{{ ai_gen_id }}">
    {% if block.settings.video %}
      <video
        class="ai-video-element-{{ ai_gen_id }}"
        playsinline
        {% if block.settings.autoplay %}autoplay{% endif %}
        {% if block.settings.loop %}loop{% endif %}
        {% unless block.settings.enable_sound %}muted{% endunless %}
        preload="metadata"
      >
        <source src="{{ block.settings.video }}" type="video/mp4">
        Your browser does not support the video tag.
      </video>

      {% if block.settings.thumbnail %}
        <img
          src="{{ block.settings.thumbnail | image_url: width: 2000 }}"
          alt="{{ block.settings.thumbnail.alt | escape }}"
          class="ai-video-thumbnail-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.thumbnail.width }}"
          height="{{ block.settings.thumbnail.height }}"
        >
      {% endif %}

      {% unless block.settings.autoplay %}
        <button
          class="ai-video-play-button-{{ ai_gen_id }}"
          aria-label="Play video"
        >
          <svg
            class="ai-video-play-icon-{{ ai_gen_id }}"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
      {% endunless %}

      <div class="ai-video-controls-{{ ai_gen_id }}">
        <button
          class="ai-video-control-button-{{ ai_gen_id }} ai-video-pause-button-{{ ai_gen_id }}"
          aria-label="Pause video"
          style="display: none;"
        >
          <svg
            class="ai-video-control-icon-{{ ai_gen_id }}"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
          </svg>
        </button>

        {% if block.settings.enable_sound %}
          <button
            class="ai-video-control-button-{{ ai_gen_id }} ai-video-mute-button-{{ ai_gen_id }}"
            aria-label="Mute video"
          >
            <svg
              class="ai-video-control-icon-{{ ai_gen_id }} ai-video-sound-on-icon-{{ ai_gen_id }}"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
            </svg>
            <svg
              class="ai-video-control-icon-{{ ai_gen_id }} ai-video-sound-off-icon-{{ ai_gen_id }}"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              style="display: none;"
            >
              <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
            </svg>
          </button>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-video-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-video-empty-state-{{ ai_gen_id }}">
          Next, add a video file
        </div>
      </div>
    {% endif %}
  </div>
</video-player-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoPlayer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.video = this.querySelector('.ai-video-element-{{ ai_gen_id }}');
        this.thumbnail = this.querySelector('.ai-video-thumbnail-{{ ai_gen_id }}');
        this.playButton = this.querySelector('.ai-video-play-button-{{ ai_gen_id }}');
        this.pauseButton = this.querySelector('.ai-video-pause-button-{{ ai_gen_id }}');
        this.muteButton = this.querySelector('.ai-video-mute-button-{{ ai_gen_id }}');
        this.soundOnIcon = this.querySelector('.ai-video-sound-on-icon-{{ ai_gen_id }}');
        this.soundOffIcon = this.querySelector('.ai-video-sound-off-icon-{{ ai_gen_id }}');

        this.autoplay = this.dataset.autoplay === 'true';
        this.loop = this.dataset.loop === 'true';
        this.enableSound = this.dataset.enableSound === 'true';

        if (!this.video) return;

        this.setupEventListeners();

        if (this.autoplay) {
          this.playVideo();
        }
      }

      setupEventListeners() {
        if (this.playButton) {
          this.playButton.addEventListener('click', () => this.playVideo());
        }

        if (this.pauseButton) {
          this.pauseButton.addEventListener('click', () => this.pauseVideo());
        }

        if (this.muteButton) {
          this.muteButton.addEventListener('click', () => this.toggleMute());
        }

        this.video.addEventListener('play', () => this.onPlay());
        this.video.addEventListener('pause', () => this.onPause());
        this.video.addEventListener('ended', () => this.onEnded());
      }

      playVideo() {
        if (this.video) {
          this.video.play();
        }
      }

      pauseVideo() {
        if (this.video) {
          this.video.pause();
        }
      }

      toggleMute() {
        if (this.video) {
          this.video.muted = !this.video.muted;
          this.updateMuteButton();
        }
      }

      updateMuteButton() {
        if (this.soundOnIcon && this.soundOffIcon) {
          if (this.video.muted) {
            this.soundOnIcon.style.display = 'none';
            this.soundOffIcon.style.display = 'block';
            this.muteButton.setAttribute('aria-label', 'Unmute video');
          } else {
            this.soundOnIcon.style.display = 'block';
            this.soundOffIcon.style.display = 'none';
            this.muteButton.setAttribute('aria-label', 'Mute video');
          }
        }
      }

      onPlay() {
        if (this.thumbnail) {
          this.thumbnail.classList.add('hidden');
        }
        if (this.playButton) {
          this.playButton.classList.add('hidden');
        }
        if (this.pauseButton) {
          this.pauseButton.style.display = 'flex';
        }
      }

      onPause() {
        if (this.pauseButton) {
          this.pauseButton.style.display = 'none';
        }
        if (this.playButton && !this.autoplay) {
          this.playButton.classList.remove('hidden');
        }
      }

      onEnded() {
        if (!this.loop) {
          if (this.thumbnail) {
            this.thumbnail.classList.remove('hidden');
          }
          if (this.playButton) {
            this.playButton.classList.remove('hidden');
          }
          if (this.pauseButton) {
            this.pauseButton.style.display = 'none';
          }
        }
      }
    }

    customElements.define('video-player-{{ ai_gen_id }}', VideoPlayer{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Video player",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video file"
    },
    {
      "type": "image_picker",
      "id": "thumbnail",
      "label": "Thumbnail image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sound",
      "label": "Enable sound",
      "info": "When enabled, video will play with sound when clicked",
      "default": false
    },
    {
      "type": "header",
      "content": "Play button"
    },
    {
      "type": "range",
      "id": "play_button_size",
      "label": "Size",
      "min": 40,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "color",
      "id": "play_button_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "play_button_icon_color",
      "label": "Icon color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Control buttons"
    },
    {
      "type": "color",
      "id": "control_button_bg",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "control_button_icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Video player"
    }
  ]
}
{% endschema %}
