{% doc %}
  @prompt
    Create a video section that can display multiple videos in a grid layout. Each video should have a play button overlay, thumbnail image, and a setting to control whether the video plays with sound or muted when clicked. The section should support adding multiple video blocks so merchants can display 4 or more videos in a grid similar to a social media feed.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-video-grid-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-video-grid-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-video-grid-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-video-grid-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.video_aspect_ratio }};
    background-color: {{ block.settings.video_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    cursor: pointer;
  }

  .ai-video-grid-thumbnail-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-video-grid-item-{{ ai_gen_id }}.playing .ai-video-grid-thumbnail-{{ ai_gen_id }} {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-grid-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-grid-play-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.play_button_size }}px;
    height: {{ block.settings.play_button_size }}px;
    background-color: {{ block.settings.play_button_bg }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.3s ease, opacity 0.3s ease;
    z-index: 2;
  }

  .ai-video-grid-play-button-{{ ai_gen_id }}:hover {
    transform: translate(-50%, -50%) scale(1.1);
  }

  .ai-video-grid-item-{{ ai_gen_id }}.playing .ai-video-grid-play-button-{{ ai_gen_id }} {
    opacity: 0;
    pointer-events: none;
  }

  .ai-video-grid-play-icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.play_button_size }}px * 0.4);
    height: calc({{ block.settings.play_button_size }}px * 0.4);
    margin-left: calc({{ block.settings.play_button_size }}px * 0.05);
  }

  .ai-video-grid-play-icon-{{ ai_gen_id }} polygon {
    fill: {{ block.settings.play_button_icon_color }};
  }

  .ai-video-grid-sound-toggle-{{ ai_gen_id }} {
    position: absolute;
    bottom: 15px;
    right: 15px;
    width: 40px;
    height: 40px;
    background-color: {{ block.settings.sound_button_bg }};
    border: none;
    border-radius: 50%;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: transform 0.2s ease;
  }

  .ai-video-grid-sound-toggle-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-video-grid-item-{{ ai_gen_id }}.playing .ai-video-grid-sound-toggle-{{ ai_gen_id }} {
    display: flex;
  }

  .ai-video-grid-sound-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
  }

  .ai-video-grid-sound-icon-{{ ai_gen_id }} path {
    fill: {{ block.settings.sound_button_icon_color }};
  }

  .ai-video-grid-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    position: relative;
  }

  .ai-video-grid-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-video-grid-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-video-grid-items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-video-grid-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-video-grid-play-button-{{ ai_gen_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.8);
      height: calc({{ block.settings.play_button_size }}px * 0.8);
    }

    .ai-video-grid-play-icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.play_button_size }}px * 0.32);
      height: calc({{ block.settings.play_button_size }}px * 0.32);
      margin-left: calc({{ block.settings.play_button_size }}px * 0.04);
    }
  }
{% endstyle %}

<video-grid-{{ ai_gen_id }} class="ai-video-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-video-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-video-grid-items-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign video_key = 'video_' | append: i
          assign thumbnail_key = 'thumbnail_' | append: i
          assign muted_key = 'muted_' | append: i
          
          assign video = block.settings[video_key]
          assign thumbnail = block.settings[thumbnail_key]
          assign muted = block.settings[muted_key]
        %}

        {% if video != blank %}
          <div class="ai-video-grid-item-{{ ai_gen_id }}" data-video-index="{{ i }}">
            {% if thumbnail != blank %}
              <img
                src="{{ thumbnail | image_url: width: 800 }}"
                alt="{{ thumbnail.alt | escape }}"
                class="ai-video-grid-thumbnail-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ thumbnail.width }}"
                height="{{ thumbnail.height }}"
              >
            {% else %}
              <div class="ai-video-grid-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
                <div class="ai-video-grid-empty-state-{{ ai_gen_id }}">
                  Add a thumbnail image
                </div>
              </div>
            {% endif %}

            <video
              class="ai-video-grid-video-{{ ai_gen_id }}"
              {% if muted %}muted{% endif %}
              playsinline
              loop
              preload="metadata"
            >
              {% for source in video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            </video>

            <button
              class="ai-video-grid-play-button-{{ ai_gen_id }}"
              aria-label="Play video"
            >
              <svg class="ai-video-grid-play-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <polygon points="5,3 19,12 5,21" />
              </svg>
            </button>

            <button
              class="ai-video-grid-sound-toggle-{{ ai_gen_id }}"
              aria-label="Toggle sound"
              data-muted="{{ muted }}"
            >
              <svg class="ai-video-grid-sound-icon-{{ ai_gen_id }} ai-video-grid-sound-on-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="display: {% if muted %}none{% else %}block{% endif %};">
                <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
              </svg>
              <svg class="ai-video-grid-sound-icon-{{ ai_gen_id }} ai-video-grid-sound-off-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="display: {% if muted %}block{% else %}none{% endif %};">
                <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
              </svg>
            </button>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</video-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentlyPlaying = null;
      }

      connectedCallback() {
        this.videoItems = this.querySelectorAll('.ai-video-grid-item-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.videoItems.forEach((item) => {
          const video = item.querySelector('.ai-video-grid-video-{{ ai_gen_id }}');
          const playButton = item.querySelector('.ai-video-grid-play-button-{{ ai_gen_id }}');
          const soundToggle = item.querySelector('.ai-video-grid-sound-toggle-{{ ai_gen_id }}');

          playButton.addEventListener('click', () => {
            this.playVideo(item, video);
          });

          item.addEventListener('click', (e) => {
            if (e.target === item || e.target.classList.contains('ai-video-grid-thumbnail-{{ ai_gen_id }}')) {
              this.playVideo(item, video);
            }
          });

          soundToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            this.toggleSound(video, soundToggle);
          });

          video.addEventListener('ended', () => {
            video.currentTime = 0;
            video.play();
          });
        });
      }

      playVideo(item, video) {
        if (this.currentlyPlaying && this.currentlyPlaying !== video) {
          this.currentlyPlaying.pause();
          this.currentlyPlaying.currentTime = 0;
          this.currentlyPlaying.closest('.ai-video-grid-item-{{ ai_gen_id }}').classList.remove('playing');
        }

        item.classList.add('playing');
        video.play();
        this.currentlyPlaying = video;
      }

      toggleSound(video, button) {
        const soundOnIcon = button.querySelector('.ai-video-grid-sound-on-{{ ai_gen_id }}');
        const soundOffIcon = button.querySelector('.ai-video-grid-sound-off-{{ ai_gen_id }}');

        video.muted = !video.muted;

        if (video.muted) {
          soundOnIcon.style.display = 'none';
          soundOffIcon.style.display = 'block';
        } else {
          soundOnIcon.style.display = 'block';
          soundOffIcon.style.display = 'none';
        }
      }
    }

    customElements.define('video-grid-{{ ai_gen_id }}', VideoGrid{{ ai_gen_id }});
  })();
</script>

