{% doc %}
  @prompt
    Create a compact Black Friday promotional sticker for the homepage, designed to sit alongside the Steady On Product Hero. Text: 'BLACK FRIDAY' and '15% OFF'. Match the store's existing fonts and colours, with a bold high-contrast sticker-style shape, readable on mobile and desktop. Make wording, colours and size customizable. Keep it distinct from final-sale or no-return messaging. Do not change product prices or existing content.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bf-sticker-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 2px solid {{ block.settings.text_color }};
    border-radius: {{ block.settings.shape_radius }}px;
    text-align: center;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    line-height: 1.05;
    box-shadow: 3px 3px 0 {{ block.settings.text_color }};
  }
  .ai-bf-sticker-{{ ai_gen_id }}__headline {
    display: block;
    margin: 0 0 3px;
    font-family: {{ settings.type_subheading_font.family }}, {{ settings.type_subheading_font.fallback_families }};
    font-size: {{ block.settings.headline_size }}px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .ai-bf-sticker-{{ ai_gen_id }}__offer {
    display: block;
    margin: 0;
    font-size: {{ block.settings.offer_size }}px;
    font-weight: 800;
    letter-spacing: -.03em;
  }
  @media screen and (max-width: 749px) {
    .ai-bf-sticker-{{ ai_gen_id }} { padding: {{ block.settings.padding | times: 0.75 | round }}px; }
    .ai-bf-sticker-{{ ai_gen_id }}__headline { font-size: {{ block.settings.headline_size | times: 0.85 | round }}px; }
    .ai-bf-sticker-{{ ai_gen_id }}__offer { font-size: {{ block.settings.offer_size | times: 0.85 | round }}px; }
  }
{% endstyle %}

<div class="ai-bf-sticker-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <span class="ai-bf-sticker-{{ ai_gen_id }}__headline">{{ block.settings.headline | escape }}</span>
  <span class="ai-bf-sticker-{{ ai_gen_id }}__offer">{{ block.settings.offer | escape }}</span>
</div>

{% schema %}
{
  "name": "Black Friday sticker",
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "BLACK FRIDAY" },
    { "type": "text", "id": "offer", "label": "Offer", "default": "15% OFF" },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFF184" },
    { "type": "color", "id": "text_color", "label": "Text and outline", "default": "#221F1F" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "headline_size", "label": "Headline size", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "offer_size", "label": "Offer size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding", "label": "Sticker padding", "min": 4, "max": 24, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "shape_radius", "label": "Corner roundness", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 }
  ],
  "presets": [{ "name": "Black Friday sticker" }],
  "tag": null,
  "class": "black-friday-sticker"
}
{% endschema %}